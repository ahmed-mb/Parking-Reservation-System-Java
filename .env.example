# Copy this file to .env and fill in real values. .env is gitignored —
# never commit actual secrets.
#
# Usage: docker compose --env-file .env up --build
# (Compose also auto-loads a file literally named .env in this directory.)

# Cryptographically random string, 32+ characters (256+ bits) for HS256.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Strong initial password for the seeded admin@parking.com account.
# Change it after first login regardless.
ADMIN_DEFAULT_PASSWORD=

# reCAPTCHA v3 keys from https://www.google.com/recaptcha/admin
# Register a site for the domain you're actually deploying to (including
# the demo domain, e.g. your Tailscale Funnel hostname) — reCAPTCHA
# validates the token against the registered domain.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
